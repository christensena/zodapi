{
  "name": "@zodapi/example-api",
  "version": "0.1.0",
  "private": true,
  "description": "Example shared API contract (routes) consumed by both server and client",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zodapi/core": "workspace:*",
    "zod": "catalog:"
  }
}
