{
  "name": "@zodapi/example-app",
  "version": "0.1.0",
  "private": true,
  "description": "Example Hono API server using @zodapi/hono, runnable locally",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
