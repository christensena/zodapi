{
  "name": "@zodapi/hono",
  "version": "0.1.0",
  "description": "Thin preset over @hono/zod-openapi: fixed 400 validation error shape and route helper",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zodapi/core": "workspace:*"
  },
  "devDependencies": {
    "@hono/zod-openapi": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@hono/zod-openapi": "catalog:peers",
    "hono": "catalog:peers",
    "zod": "catalog:peers"
  }
}
